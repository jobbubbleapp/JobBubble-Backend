# JobBubble Backend configuration
# Copy this file to .env for local development and provide your own credentials.
# NEVER commit the real .env file or real credentials.

PORT=3000

# Active job providers
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
USAJOBS_API_KEY=your_usajobs_api_key
USAJOBS_EMAIL=your_usajobs_registered_email
THE_MUSE_API_KEY=your_the_muse_api_key

# Public ATS feeds (Greenhouse, Lever, Ashby)
# Default curated hourly/retail/restaurant boards are enabled automatically.
ATS_USE_DEFAULT_BOARDS=true
# Cache each employer board to avoid re-downloading it on every user search.
ATS_CACHE_TTL_MS=900000
# Optional: add more employer boards without changing code.
# Format: [{"provider":"lever|greenhouse|ashby","board":"board-name","company":"Company Name"}]
ATS_BOARDS_JSON=[]

# Location/geocoding
GEOAPIFY_API_KEY=your_geoapify_api_key

# In-app bug reports -> GitHub Issues.
# Use a fine-grained token with Issues: Read and write permission for the target repo.
# Keep the real token only on the backend/Render; NEVER put it in the Android app.
GITHUB_ISSUES_TOKEN=your_fine_grained_github_token
GITHUB_ISSUES_REPO=jobbubbleapp/JobBubbleApp

# Providers retained for future/diagnostic use

# Never put production credentials in this example file.
